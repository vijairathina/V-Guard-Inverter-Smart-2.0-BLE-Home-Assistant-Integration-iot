# ==============================================================================
# Git Ignore for V-Guard BLE & Home Assistant Integration
# ==============================================================================

# --- Sensitive Credentials & Local Configuration ---
ha_config.json
.env
.env.*
*.pem
*.key

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Logs & Runtime Output ---
*.log
vguard_app.log
androguard.log
inverter_test.log
nfr log/
logs/

# --- Reverse Engineering Dumps & Large External Binaries ---
# WARNING: GitHub rejects individual files > 100MB (e.g. jdk.zip is ~186MB)
jdk/
jdk.zip
jadx/
jadx.zip
*.apk
*.apk+
V-Guard Smart*
V-Guard_jadx/
search_results*.txt
smali.txt

# --- IDEs & Code Editors ---
.vscode/
.idea/
.qodo/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- OS-generated Files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
